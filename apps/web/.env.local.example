# Copy to apps/web/.env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute site origin used for canonicals, Open Graph URLs, sitemap.xml, and
# robots.txt. Set the real domain in Vercel Production; when unset on Vercel the
# app falls back to the deployment's own URL, and locally to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog (optional; unset = analytics no ops)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
